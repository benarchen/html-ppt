{
  "name": "replace-me",
  "version": "0.1.0",
  "schemaVersion": 1,
  "engine": ">=0.1 <1",
  "canvas": {
    "ratio": "16:9",
    "width": 1280,
    "height": 720,
    "safeArea": 64,
    "grid": { "columns": 12, "gap": 24 }
  },
  "typography": {
    "display": { "family": "Arial, sans-serif", "minSize": 48 },
    "heading": { "family": "Arial, sans-serif", "minSize": 24 },
    "body": { "family": "Arial, sans-serif", "minSize": 18 },
    "caption": { "family": "ui-monospace, monospace", "minSize": 14 }
  },
  "colors": {
    "background": "#ffffff",
    "surface": "#f5f5f5",
    "text": "#111111",
    "muted": "#666666",
    "accent": "#3366ff",
    "accentAlt": "#6633ff",
    "border": "#dddddd"
  },
  "spacing": { "unit": 8 },
  "radii": { "small": 8, "large": 16 },
  "shadows": { "card": "none" },
  "imageTreatment": { "radius": 16, "filter": "none" },
  "chartPalette": ["#3366ff", "#6633ff", "#00aa88"],
  "supportedLayouts": ["cover", "section", "title-body", "two-column", "image-text", "metrics", "comparison", "timeline", "quote", "chart", "full-bleed-image", "ending"]
}

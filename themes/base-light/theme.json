{
  "name": "base-light",
  "version": "0.1.0",
  "schemaVersion": 1,
  "engine": ">=0.1 <1",
  "canvas": {
    "ratio": "16:9",
    "width": 1280,
    "height": 720,
    "safeArea": 64,
    "grid": { "columns": 12, "gap": 24 }
  },
  "typography": {
    "display": { "family": "Inter, Arial, sans-serif", "minSize": 48 },
    "heading": { "family": "Inter, Arial, sans-serif", "minSize": 24 },
    "body": { "family": "Inter, Arial, sans-serif", "minSize": 18 },
    "caption": { "family": "ui-monospace, monospace", "minSize": 14 }
  },
  "colors": {
    "background": "#f5f1e8",
    "surface": "#fffdf8",
    "text": "#18202a",
    "muted": "#68717d",
    "accent": "#ef5b3f",
    "accentAlt": "#2d7a78",
    "border": "#d9d2c6"
  },
  "spacing": { "unit": 8 },
  "radii": { "small": 10, "large": 24 },
  "shadows": { "card": "0 18px 50px rgba(45, 36, 25, 0.10)" },
  "imageTreatment": { "radius": 24, "filter": "saturate(0.92) contrast(1.04)" },
  "chartPalette": ["#ef5b3f", "#2d7a78", "#e1a72c", "#6b5db3"],
  "supportedLayouts": ["cover", "section", "title-body", "two-column", "image-text", "metrics", "comparison", "timeline", "quote", "chart", "full-bleed-image", "ending"]
}
